{
  "expo": {
    "name": "Owezy Receipt Splitter",
    "slug": "owezy-receipt-splitter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "owezy-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.owezy.receipt.splitter",
      "infoPlist": {
        "NSCameraUsageDescription": "Owezy uses your camera to scan receipts for bill splitting.",
        "NSPhotoLibraryUsageDescription": "Owezy uses your photo library so you can upload receipt images.",
        "NSUserTrackingUsageDescription": "Owezy uses this permission to support ads and improve ad performance.",
        "LSApplicationQueriesSchemes": [
          "venmo",
          "cashapp",
          "sms"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#58835A"
      },
      "package": "app.owezy.receipt_splitter"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://owezy.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-tracking-transparency"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://owezy.app/"
      },
      "eas": {
        "projectId": "4dd9ff44-35ec-4b8b-a60a-1922872cbd04"
      }
    },
    "owner": "cmhigney"
  }
}
