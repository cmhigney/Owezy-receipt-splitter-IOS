{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "lib",
    "rootDir": "..",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "../backend/**/*.ts",
    "../types/**/*.ts",
    "../utils/**/*.ts"
  ]
}
