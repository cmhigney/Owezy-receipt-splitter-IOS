# A/B testing variant (A or B). Change, rebuild, run: maestro test .maestro/bot_split_flow.yaml
EXPO_PUBLIC_AB_VARIANT=A

# Firebase Cloud Function base URL
# Replace <project-id> with your Firebase project id.
EXPO_PUBLIC_API_BASE_URL=https://us-central1-<project-id>.cloudfunctions.net/backend

# Firebase client app config
# Copy these from Firebase Console -> Project settings -> Your apps
# These values identify the public client app and are expected to be exposed to the mobile app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# RevenueCat (Pro subscriptions)
# Create a RevenueCat project and copy your public SDK keys:
# iOS key starts with "appl_"
# Android key starts with "goog_"
# These are public SDK keys, not server secrets.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# Scan pricing defaults (frontend display + fallback logic)
EXPO_PUBLIC_FREE_SCANS_PER_MONTH=5
# iOS on-device OCR (Apple Vision) toggle.
# Requires a native module named AppleVisionOCR with recognizeText(imageUri) -> string | string[] | { text?: string; lines?: string[] }.
# This repo includes a local Expo module implementation at modules/apple-vision-ocr.
EXPO_PUBLIC_IOS_ON_DEVICE_OCR_ENABLED=1
# If 1, only fallback to cloud image OCR when on-device parse returns NO_ITEMS_OR_TOTAL.
EXPO_PUBLIC_IOS_ON_DEVICE_OCR_FALLBACK_ONLY_ON_NO_ITEMS=1
# Optional client-side OCR timeout in milliseconds before the scan UI fails fast.
EXPO_PUBLIC_OCR_PARSE_TIMEOUT_MS=12000

# Optional ads (non-Pro users)
# Set EXPO_PUBLIC_ADS_ENABLED=0 to disable all ads globally.
EXPO_PUBLIC_ADS_ENABLED=1
# Required native AdMob app IDs when you install react-native-google-mobile-ads.
# These are different from banner unit IDs.
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
# Use your production ad unit IDs in release builds.
# If blank, the app disables native banners and falls back to an internal Pro promo card.
EXPO_PUBLIC_ADMOB_HISTORY_BANNER_ID=
EXPO_PUBLIC_ADMOB_FRIENDS_BANNER_ID=

# Backend RevenueCat secret key (used server-side to enforce scan allowances)
# Never place server secrets in EXPO_PUBLIC_* variables or Expo extra config.
# If a server secret was ever exposed in a client build or committed to source control, rotate it immediately.
# Set this in functions/.env for Firebase deploy:
# OWEZY_REVENUECAT_SECRET_API_KEY=rc_...
# Optional (defaults to "pro")
# OWEZY_REVENUECAT_ENTITLEMENT_ID=pro
# Optional scan allowance defaults (functions runtime):
# OWEZY_FREE_SCANS_PER_MONTH=5
# OWEZY_PRO_MONTHLY_SCANS_PER_MONTH=40
# OWEZY_PRO_YEARLY_SCANS_PER_MONTH=60
# Optional RevenueCat product ID mapping (comma-separated):
# OWEZY_RC_PRODUCT_IDS_PRO_MONTHLY=owezy_pro_monthly
# OWEZY_RC_PRODUCT_IDS_PRO_YEARLY=owezy_pro_annual
# Optional OCR routing mode:
# docai_first (default): best quality, highest cost
# vision_first_guarded: run Vision first, escalate to DocAI only for low-confidence parses
# OWEZY_OCR_ROUTING_MODE=docai_first
# Optional Vision-first quality gate tuning:
# OWEZY_VISION_FIRST_MAX_SCORE=0.08
# OWEZY_VISION_FIRST_MIN_ITEM_COUNT=2
# Optional baseline rate limiting (all values are per-route budgets):
# OWEZY_PUBLIC_RATE_LIMIT_WINDOW_MS=300000
# OWEZY_PUBLIC_RATE_LIMIT_MAX_PER_IP=180
# OWEZY_PUBLIC_RATE_LIMIT_MAX_PER_USER=90
# OWEZY_PROTECTED_RATE_LIMIT_WINDOW_MS=300000
# OWEZY_PROTECTED_RATE_LIMIT_MAX_PER_IP=600
# OWEZY_PROTECTED_RATE_LIMIT_MAX_PER_USER=300

# Optional store mode override:
# auto (default) -> Firestore in Firebase runtime, SQLite locally
# firebase -> always Firestore
# sqlite-file -> always SQLite file
# memory -> in-memory SQLite
# OWEZY_STORE_MODE=auto

# Optional local-only auth shortcut for emulator/dev work.
# Never enable this in deployed environments.
# OWEZY_ALLOW_INSECURE_LOCAL_AUTH=1

# Recommended in deployed environments so browser requests are constrained to your app origins.
# Example: OWEZY_ALLOWED_ORIGINS=https://owezy.app,https://www.owezy.app

# Optional E2E-only client flags for CI simulator builds.
# EXPO_PUBLIC_E2E_SKIP_EMAIL_VERIFICATION=1
# EXPO_PUBLIC_E2E_ENABLE_TEST_RECEIPTS=1
